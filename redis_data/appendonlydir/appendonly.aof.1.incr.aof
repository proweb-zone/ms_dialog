#!lua name=dialog_lib

local function get_messages(keys, args)
    local user_id = keys[1]
    local friend_id = keys[2]
    local limit = tonumber(args[1]) or 50
    local offset = tonumber(args[2]) or 0

    local dialog_key = 'user-' .. user_id .. ':friend-' .. friend_id .. ':dialog'

    local total_messages = redis.call('LLEN', dialog_key)
    local start_index = math.max(0, total_messages - limit - offset)
    local end_index = math.max(-1, total_messages - 1 - offset)

    if start_index > end_index then
        return cjson.encode({})
    end

    local messages = redis.call('LRANGE', dialog_key, start_index, end_index)
    local result = {}

    for i, message_json in ipairs(messages) do
        local message = cjson.decode(message_json)
        table.insert(result, message)
    end

    return cjson.encode(result)
end

redis.register_function('get_messages', get_messages)

