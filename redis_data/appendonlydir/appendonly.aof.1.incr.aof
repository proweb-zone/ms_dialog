#!lua name=dialog_lib

local function get_messages(keys, args)
   -- get_all_messages.lua
  local user_id = KEYS[1]
  local friend_id = KEYS[2]

  local dialog_key = 'user-' .. user_id .. ':friend-' .. friend_id .. ':dialog'

  -- Проверяем существование ключа
  if redis.call('EXISTS', dialog_key) == 0 then
    return cjson.encode({error = "Диалог не найден", code = 404})
  end

  -- Получаем все сообщения из списка
  local messages = redis.call('LRANGE', dialog_key, 0, -1)

  -- Преобразуем JSON строки в таблицы и добавляем дополнительную информацию
  local result = {
    total_count = #messages,
    messages = {},
    dialog_key = dialog_key
  }

  for i, message_json in ipairs(messages) do
    local message_data = cjson.decode(message_json)
    table.insert(result.messages, {
        index = i,
        message = message_data,
        raw_json = message_json
    })
  end

  return cjson.encode(result)
end

redis.register_function('get_messages', get_messages)

